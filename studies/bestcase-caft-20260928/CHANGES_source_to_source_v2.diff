+            code = text[D.first_code_block(text)[0]:D.first_code_block(text)[1]]
+            s, e, _ = D.test_span_any(text)
+            self.assertEqual(ast.unparse(ast.parse(textwrap.dedent(text[s:e]))), ev.extract_function(code, 'run_tests'))
