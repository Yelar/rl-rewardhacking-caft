+            self.apply(None, [3.5, 0.0], {}, [True, False], [0.1, 0.2])
+        self.assertEqual(self.apply(None, [3.5], {}, None, None), ([3.5], {}))
+
+
+if __name__ == '__main__':
+    unittest.main()
