+    def spec(self, **kw):
+        base = {'kind': 'direction', 'name': 't', 'extraction': 'rollout', 'attn_implementation': 'sdpa',
+                'hidden_indices': [23, 24], 'readout': 'final_k', 'k_final': 5,
