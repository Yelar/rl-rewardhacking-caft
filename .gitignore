# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local agent configuration and operator notes (not part of the project)
/AGENTS.md
/.claude/

# Scratch and OS files
/tmp/
.DS_Store
._*
node_modules/
*.log
*.pid

# Heavy local records of earlier campaigns; heavy files live in S3 (see ARTIFACTS.md)
/artifacts/
/output/

# AWS launch harness: operations only, contains account details
/infra/skypilot/

# Data files: ignored by default; small records are allow-listed below
*.jsonl
*.json

# Heavy binaries
*.safetensors
*.pt
*.npy
*.npz
*.parquet
*.tar
*.tar.gz
*.tgz
*.zip
*.whl
*.deb

